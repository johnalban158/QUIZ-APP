# Quiz App server environment template.
# Copy the values you already have in .env and add the Cloudinary keys below.

DATABASE_URL="postgresql://postgres:quizapp123@localhost:5432/quizapp?schema=public"
JWT_SECRET="change-me"
PORT=4000

# --- Question audio/video uploads (Cloudinary free tier) ---
# 1. Create a free account at https://cloudinary.com
# 2. Copy the 3 values from your dashboard ("Product Environment Settings").
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""